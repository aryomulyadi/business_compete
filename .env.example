# ===================================================================
# BizComp AI — Environment Variables
# ===================================================================

# Required: Serper.dev search API key (https://serper.dev)
SERPER_API_KEY=

# Required: at least one LLM provider API key
MIMO_API_KEY=
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_THINKING=disabled
GROQ_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=

# OpenRouter (alternative LLM provider)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# Apify (web scraping, used by some tools)
APIFY_API_KEY=

# OmniRoute OpenAI-compatible local gateway (required when LLM_PROVIDER=omniroute)
OMNIROUTE_API_KEY=
OMNIROUTE_BASE_URL=
OMNIROUTE_MODEL=auto

# Cloudflare AI (logo generation) — optional, fallback ke Gemini jika kosong
CLOUDFLARE_AI_URL=https://free-image-generation-api.aryoyo52.workers.dev
CLOUDFLARE_AI_KEY=

# Optional: choose one of mimo, groq, deepseek, gemini, openai, openai-mini, omniroute
LLM_PROVIDER=mimo
