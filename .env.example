# ===================================================================
# BizComp AI — Environment Variables
# ===================================================================

# Required: Serper.dev search API key (https://serper.dev)
SERPER_API_KEY=

# Required: at least one LLM provider API key
MIMO_API_KEY=
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_THINKING=disabled
GROQ_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=

# OpenRouter (alternative LLM provider)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# Apify (web scraping, used by some tools)
APIFY_API_KEY=

# OmniRoute OpenAI-compatible local gateway (required when LLM_PROVIDER=omniroute)
OMNIROUTE_API_KEY=
OMNIROUTE_BASE_URL=
OMNIROUTE_MODEL=auto

# Cloudflare AI (logo generation) — langsung via REST API (optional)
# Dapatkan Account ID dari dashboard: https://dash.cloudflare.com/
# Dapatkan API Token dari: https://developers.cloudflare.com/fundamentals/api/get-started/create-token/
# (minimal permission: Workers AI -> Run)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Optional: choose one of mimo, groq, deepseek, gemini, openai, openai-mini, omniroute
LLM_PROVIDER=mimo

# Production persistence (required for Vercel API + external analysis worker)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
BLOB_READ_WRITE_TOKEN=
CORS_ORIGINS=https://your-frontend.vercel.app
NEXT_PUBLIC_API_URL=https://your-api.vercel.app
